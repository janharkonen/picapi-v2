# S3-compatible object storage (MinIO, Garage, R2, Spaces, and similar)
S3_ENDPOINT=https://s3.example.com
S3_REGION=auto
S3_BUCKET=
S3_ENV_PREFIX=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Path-style URLs are required by most S3-compatible stores. Set false for virtual-hosted-style.
S3_USE_PATH_STYLE=true
