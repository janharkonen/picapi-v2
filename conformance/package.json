{
  "name": "picapi-conformance",
  "private": true,
  "type": "module",
  "description": "Black-box tests that every picapi implementation must pass",
  "scripts": {
    "test": "node --test --test-concurrency=1 conformance.test.ts",
    "test:local": "BASE_URL=http://localhost:8080 API_KEY=$(grep ^PICAPI_API_KEY= ../api-go/.env | cut -d= -f2) node --test --test-concurrency=1 conformance.test.ts"
  },
  "dependencies": {
    "sharp": "^0.35.5"
  }
}
