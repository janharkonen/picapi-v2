# Copy to .env (not committed). Local development uses the Railway bucket picapi-images-dev:
#   railway bucket credentials --bucket picapi-images-dev
S3_ENDPOINT=https://t3.storageapi.dev
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_PATH_STYLE=false

PUBLIC_BASE_URL=http://localhost:8080
# Both at least 32 characters.
SIGNING_SECRET=
PICAPI_API_KEY=
# The SvelteKit dev server, reverse-proxied under /ui.
FRONTEND_URL=http://localhost:5173
# ONNX Runtime 1.31 is only in the Docker image; set BG_MODEL=isnet with ONNXRUNTIME_LIB and BG_MODEL_DIR to enable locally.
BG_MODEL=off
